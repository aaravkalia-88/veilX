digraph veilx {
graph [rankdir=TB, newrank=true, bgcolor="#f5effd", fontname="Arial", fontsize=17, nodesep=.32, ranksep=.8, pad=.45, splines=ortho, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12, fontcolor="#302c40", color="#afa6ca", penwidth=1, margin=".16,.11", width=2.1];
edge [fontname="Arial", fontsize=9, color="#858093", fontcolor="#686174", arrowsize=.55, penwidth=.9];
subgraph "cluster_experience" { label="01 / PERSON + EXTENSION EXPERIENCE"; labelloc=t; labeljust=l; style="rounded,filled"; color="#d9d2e5"; fillcolor="#fdfcff"; margin=24;
"user" [id="node-user", label=<<B>Person using VeilX</B><BR/><FONT POINT-SIZE="9">User / browser</FONT>>, fillcolor="#e8e4ff", shape=ellipse];
"shell" [id="node-shell", label=<<B>Extension shell</B><BR/><FONT POINT-SIZE="9">sidepanel/App.tsx</FONT>>, fillcolor="#e8e4ff"];
"composer" [id="node-composer", label=<<B>Protected prompt composer</B><BR/><FONT POINT-SIZE="9">components/ProtectedComposer.tsx</FONT>>, fillcolor="#e8e4ff"];
"reply-panel" [id="node-reply-panel", label=<<B>Private restored answer</B><BR/><FONT POINT-SIZE="9">components/PrivateReply.tsx</FONT>>, fillcolor="#e8e4ff"];
"popup" [id="node-popup", label=<<B>Toolbar popup</B><BR/><FONT POINT-SIZE="9">popup/App.tsx</FONT>>, fillcolor="#e8e4ff"];
"settings" [id="node-settings", label=<<B>Local settings</B><BR/><FONT POINT-SIZE="9">options/App.tsx</FONT>>, fillcolor="#e8e4ff"];
"onboarding" [id="node-onboarding", label=<<B>Onboarding + permission guide</B><BR/><FONT POINT-SIZE="9">components/Onboarding.tsx</FONT>>, fillcolor="#e8e4ff"];
"why-panel" [id="node-why-panel", label=<<B>Why this risk?</B><BR/><FONT POINT-SIZE="9">components/PolicyEvidence.tsx</FONT>>, fillcolor="#e8e4ff"];
"progress-panel" [id="node-progress-panel", label=<<B>Live agent progress</B><BR/><FONT POINT-SIZE="9">components/AuditProgress.tsx</FONT>>, fillcolor="#e8e4ff"];
"cookie-panel" [id="node-cookie-panel", label=<<B>Active cookies / sessions section</B><BR/><FONT POINT-SIZE="9">components/CookiePanel.tsx</FONT>>, fillcolor="#e8e4ff"];
"site-consent" [id="node-site-consent", label=<<B>Optional site consent</B><BR/><FONT POINT-SIZE="9">lib/permissions.ts</FONT>>, fillcolor="#e8e4ff"];
"risk-badge" [id="node-risk-badge", label=<<B>Privacy risk badge</B><BR/><FONT POINT-SIZE="9">components/RiskBadge.tsx</FONT>>, fillcolor="#e8e4ff"];
"mode-controller" [id="node-mode-controller", label=<<B>Standard / Strict mode</B><BR/><FONT POINT-SIZE="9">lib/privacy-mode.ts</FONT>>, fillcolor="#e8e4ff"];
{rank=same; "user";}
{rank=same; "shell";}
"user" -> "shell" [style=invis,weight=100,minlen=1];
{rank=same; "composer";"reply-panel";"popup";"settings";}
"composer" -> "reply-panel" [style=invis,weight=100,constraint=false];
"reply-panel" -> "popup" [style=invis,weight=100,constraint=false];
"popup" -> "settings" [style=invis,weight=100,constraint=false];
"shell" -> "composer" [style=invis,weight=100,minlen=1];
{rank=same; "onboarding";"why-panel";"progress-panel";"cookie-panel";}
"onboarding" -> "why-panel" [style=invis,weight=100,constraint=false];
"why-panel" -> "progress-panel" [style=invis,weight=100,constraint=false];
"progress-panel" -> "cookie-panel" [style=invis,weight=100,constraint=false];
"composer" -> "onboarding" [style=invis,weight=100,minlen=1];
{rank=same; "site-consent";"risk-badge";"mode-controller";}
"site-consent" -> "risk-badge" [style=invis,weight=100,constraint=false];
"risk-badge" -> "mode-controller" [style=invis,weight=100,constraint=false];
"onboarding" -> "site-consent" [style=invis,weight=100,minlen=1];
}
subgraph "cluster_detection" { label="02 / ON-DEVICE INPUT + DETECTION"; labelloc=t; labeljust=l; style="rounded,filled"; color="#d9d2e5"; fillcolor="#fdfcff"; margin=24;
"input-events" [id="node-input-events", label=<<B>Typing + paste controller</B><BR/><FONT POINT-SIZE="9">input/controller.ts</FONT>>, fillcolor="#e8f0ff"];
"normalizer" [id="node-normalizer", label=<<B>Text spans + offset map</B><BR/><FONT POINT-SIZE="9">detection/normalize.ts</FONT>>, fillcolor="#e8f0ff"];
"regex-engine" [id="node-regex-engine", label=<<B>Regex candidate engine</B><BR/><FONT POINT-SIZE="9">detection/regex.ts</FONT>>, fillcolor="#e8f0ff"];
"phone-validator" [id="node-phone-validator", label=<<B>Phone validator</B><BR/><FONT POINT-SIZE="9">detection/phone.ts</FONT>>, fillcolor="#e8f0ff"];
"card-validator" [id="node-card-validator", label=<<B>Card validator</B><BR/><FONT POINT-SIZE="9">detection/cards.ts</FONT>>, fillcolor="#e8f0ff"];
"id-validator" [id="node-id-validator", label=<<B>ID / country rules</B><BR/><FONT POINT-SIZE="9">detection/ids.ts</FONT>>, fillcolor="#e8f0ff"];
"address-rules" [id="node-address-rules", label=<<B>Address context rules</B><BR/><FONT POINT-SIZE="9">detection/address.ts</FONT>>, fillcolor="#e8f0ff"];
"ner-model" [id="node-ner-model", label=<<B>In-browser NER model</B><BR/><FONT POINT-SIZE="9">detection/ner-worker.ts</FONT><BR/><FONT POINT-SIZE="8">PHASE 2</FONT>>, fillcolor="#e8f0ff"];
"secret-scanner" [id="node-secret-scanner", label=<<B>Cookie / token secret scanner</B><BR/><FONT POINT-SIZE="9">detection/secrets.ts</FONT>>, fillcolor="#e8f0ff"];
"overlaps" [id="node-overlaps", label=<<B>Overlap + confidence resolver</B><BR/><FONT POINT-SIZE="9">detection/resolve.ts</FONT>>, fillcolor="#e8f0ff"];
"underline-layer" [id="node-underline-layer", label=<<B>Highlights + tooltips</B><BR/><FONT POINT-SIZE="9">components/DetectionOverlay.tsx</FONT>>, fillcolor="#e8f0ff"];
"review" [id="node-review", label=<<B>Detection review / manual mark</B><BR/><FONT POINT-SIZE="9">components/ReviewDetections.tsx</FONT>>, fillcolor="#e8f0ff"];
"inpage-mode" [id="node-inpage-mode", label=<<B>Optional in-page convenience mode</B><BR/><FONT POINT-SIZE="9">input/inpage.ts</FONT>>, fillcolor="#e8f0ff"];
{rank=same; "input-events";"normalizer";"regex-engine";}
"input-events" -> "normalizer" [style=invis,weight=100,constraint=false];
"normalizer" -> "regex-engine" [style=invis,weight=100,constraint=false];
{rank=same; "phone-validator";"card-validator";"id-validator";}
"phone-validator" -> "card-validator" [style=invis,weight=100,constraint=false];
"card-validator" -> "id-validator" [style=invis,weight=100,constraint=false];
"input-events" -> "phone-validator" [style=invis,weight=100,minlen=1];
{rank=same; "address-rules";"ner-model";"secret-scanner";}
"address-rules" -> "ner-model" [style=invis,weight=100,constraint=false];
"ner-model" -> "secret-scanner" [style=invis,weight=100,constraint=false];
"phone-validator" -> "address-rules" [style=invis,weight=100,minlen=1];
{rank=same; "overlaps";"underline-layer";"review";}
"overlaps" -> "underline-layer" [style=invis,weight=100,constraint=false];
"underline-layer" -> "review" [style=invis,weight=100,constraint=false];
"address-rules" -> "overlaps" [style=invis,weight=100,minlen=1];
{rank=same; "inpage-mode";}
"overlaps" -> "inpage-mode" [style=invis,weight=100,minlen=1];
}
subgraph "cluster_entities" { label="03 / WHAT BECOMES A PLACEHOLDER"; labelloc=t; labeljust=l; style="rounded,filled"; color="#d9d2e5"; fillcolor="#fdfcff"; margin=24;
"names" [id="node-names", label=<<B>Name -&gt; [PERSON_1]</B><BR/><FONT POINT-SIZE="9">entity / PERSON</FONT><BR/><FONT POINT-SIZE="8">PHASE 2 + MANUAL MVP</FONT>>, fillcolor="#eef2ff"];
"addresses" [id="node-addresses", label=<<B>Address -&gt; [ADDRESS_1]</B><BR/><FONT POINT-SIZE="9">entity / ADDRESS</FONT>>, fillcolor="#eef2ff"];
"email" [id="node-email", label=<<B>Email -&gt; [EMAIL_1]</B><BR/><FONT POINT-SIZE="9">entity / EMAIL</FONT>>, fillcolor="#eef2ff"];
"phones" [id="node-phones", label=<<B>Mobile -&gt; [PHONE_1]</B><BR/><FONT POINT-SIZE="9">entity / PHONE</FONT>>, fillcolor="#eef2ff"];
"cards" [id="node-cards", label=<<B>Card -&gt; [CARD_1]</B><BR/><FONT POINT-SIZE="9">entity / CARD</FONT>>, fillcolor="#eef2ff"];
"ids" [id="node-ids", label=<<B>ID -&gt; [ID_1]</B><BR/><FONT POINT-SIZE="9">entity / ID</FONT>>, fillcolor="#eef2ff"];
"sessions" [id="node-sessions", label=<<B>Secret -&gt; [SESSION_1]</B><BR/><FONT POINT-SIZE="9"> SESSION / SECRET</FONT>>, fillcolor="#eef2ff"];
{rank=same; "names";"addresses";"email";}
"names" -> "addresses" [style=invis,weight=100,constraint=false];
"addresses" -> "email" [style=invis,weight=100,constraint=false];
{rank=same; "phones";"cards";"ids";}
"phones" -> "cards" [style=invis,weight=100,constraint=false];
"cards" -> "ids" [style=invis,weight=100,constraint=false];
"names" -> "phones" [style=invis,weight=100,minlen=1];
{rank=same; "sessions";}
"phones" -> "sessions" [style=invis,weight=100,minlen=1];
}
subgraph "cluster_redaction" { label="04 / LOCAL MAPPING + SAFE SEND"; labelloc=t; labeljust=l; style="rounded,filled"; color="#d9d2e5"; fillcolor="#fdfcff"; margin=24;
"registry" [id="node-registry", label=<<B>Entity registry + numbering</B><BR/><FONT POINT-SIZE="9">redaction/registry.ts</FONT>>, fillcolor="#e6edff"];
"placeholder-map" [id="node-placeholder-map", label=<<B>Temporary private mapping</B><BR/><FONT POINT-SIZE="9">redaction/session-map.ts</FONT>>, fillcolor="#e6edff", shape=cylinder];
"redactor" [id="node-redactor", label=<<B>Replace spans with placeholders</B><BR/><FONT POINT-SIZE="9">redaction/replace.ts</FONT>>, fillcolor="#e6edff"];
"auto-redact" [id="node-auto-redact", label=<<B>Auto-redact control</B><BR/><FONT POINT-SIZE="9">components/AutoRedactToggle.tsx</FONT>>, fillcolor="#e6edff"];
"send-gate" [id="node-send-gate", label=<<B>Pre-send privacy gate</B><BR/><FONT POINT-SIZE="9">redaction/send-gate.ts</FONT>>, fillcolor="#e6edff"];
"session-clear" [id="node-session-clear", label=<<B>Explicit clear + lifecycle cleanup</B><BR/><FONT POINT-SIZE="9">redaction/lifecycle.ts</FONT>>, fillcolor="#e6edff"];
"missing-map" [id="node-missing-map", label=<<B>Missing / expired map state</B><BR/><FONT POINT-SIZE="9">components/UnresolvedPlaceholder.tsx</FONT>>, fillcolor="#e6edff"];
{rank=same; "registry";"placeholder-map";"redactor";}
"registry" -> "placeholder-map" [style=invis,weight=100,constraint=false];
"placeholder-map" -> "redactor" [style=invis,weight=100,constraint=false];
{rank=same; "auto-redact";"send-gate";"session-clear";}
"auto-redact" -> "send-gate" [style=invis,weight=100,constraint=false];
"send-gate" -> "session-clear" [style=invis,weight=100,constraint=false];
"registry" -> "auto-redact" [style=invis,weight=100,minlen=1];
{rank=same; "missing-map";}
"auto-redact" -> "missing-map" [style=invis,weight=100,minlen=1];
}
subgraph "cluster_providers" { label="05 / CHATBOT ADAPTERS + AI BOUNDARY"; labelloc=t; labeljust=l; style="rounded,filled"; color="#d9d2e5"; fillcolor="#fdfcff"; margin=24;
"adapter" [id="node-adapter", label=<<B>Provider adapter registry</B><BR/><FONT POINT-SIZE="9">adapters/index.ts</FONT>>, fillcolor="#fff0dc"];
"chatgpt-adapter" [id="node-chatgpt-adapter", label=<<B>ChatGPT rich-text adapter</B><BR/><FONT POINT-SIZE="9">adapters/chatgpt.ts</FONT>>, fillcolor="#fff0dc"];
"gemini-adapter" [id="node-gemini-adapter", label=<<B>Gemini rich-text adapter</B><BR/><FONT POINT-SIZE="9">adapters/gemini.ts</FONT>>, fillcolor="#fff0dc"];
"claude-adapter" [id="node-claude-adapter", label=<<B>Claude rich-text adapter</B><BR/><FONT POINT-SIZE="9">adapters/claude.ts</FONT>>, fillcolor="#fff0dc"];
"redacted-message" [id="node-redacted-message", label=<<B>Only the redacted prompt crosses</B><BR/><FONT POINT-SIZE="9">provider-visible draft</FONT>>, fillcolor="#fff0dc"];
"ai-provider" [id="node-ai-provider", label=<<B>ChatGPT / Gemini / Claude</B><BR/><FONT POINT-SIZE="9">external AI service</FONT>>, fillcolor="#fff0dc"];
"provider-page" [id="node-provider-page", label=<<B>Provider-owned page</B><BR/><FONT POINT-SIZE="9">external DOM / scripts</FONT>>, fillcolor="#fff0dc"];
{rank=same; "adapter";"chatgpt-adapter";"gemini-adapter";}
"adapter" -> "chatgpt-adapter" [style=invis,weight=100,constraint=false];
"chatgpt-adapter" -> "gemini-adapter" [style=invis,weight=100,constraint=false];
{rank=same; "claude-adapter";"redacted-message";"ai-provider";}
"claude-adapter" -> "redacted-message" [style=invis,weight=100,constraint=false];
"redacted-message" -> "ai-provider" [style=invis,weight=100,constraint=false];
"adapter" -> "claude-adapter" [style=invis,weight=100,minlen=1];
{rank=same; "provider-page";}
"claude-adapter" -> "provider-page" [style=invis,weight=100,minlen=1];
}
subgraph "cluster_restoration" { label="06 / STREAMING REPLY + LOCAL REHYDRATION"; labelloc=t; labeljust=l; style="rounded,filled"; color="#d9d2e5"; fillcolor="#fdfcff"; margin=24;
"observer" [id="node-observer", label=<<B>Response MutationObserver</B><BR/><FONT POINT-SIZE="9">restore/observer.ts</FONT>>, fillcolor="#e7f1ff"];
