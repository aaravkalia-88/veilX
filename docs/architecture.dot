{rank=same; "observer";"stream-buffer";"token-parser";}
"observer" -> "stream-buffer" [style=invis,weight=100,constraint=false];
"stream-buffer" -> "token-parser" [style=invis,weight=100,constraint=false];
{rank=same; "map-lookup";"secret-filter";"safe-restore";}
"map-lookup" -> "secret-filter" [style=invis,weight=100,constraint=false];
"secret-filter" -> "safe-restore" [style=invis,weight=100,constraint=false];
"observer" -> "map-lookup" [style=invis,weight=100,minlen=1];
}
subgraph "cluster_cookies" { label="07 / ACTIVE COOKIE / SESSION GUARD"; labelloc=t; labeljust=l; style="rounded,filled"; color="#d9d2e5"; fillcolor="#fdfcff"; margin=24;
"cookie-jar" [id="node-cookie-jar", label=<<B>Browser-native cookie store</B><BR/><FONT POINT-SIZE="9">Chrome cookie jar</FONT>>, fillcolor="#e4f2e7", shape=cylinder];
